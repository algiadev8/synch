{
  "name": "@synch/cli",
  "version": "0.1.0",
  "description": "Headless end-to-end encrypted sync CLI for Synch vaults.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjinco/synch.git",
    "directory": "apps/cli"
  },
  "files": ["dist/synch.js", "dist/LICENSE", "dist/THIRD_PARTY_LICENSES.txt"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "synch": "./dist/synch.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsgo --noEmit --skipLibCheck && node esbuild.config.mjs",
    "prepack": "pnpm run build",
    "test:package": "node scripts/test-package.mjs",
    "test": "vitest --config vitest.config.mts",
    "typecheck": "tsgo --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@synch/sync-client": "workspace:*",
    "@types/node": "^24.0.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4"
  }
}

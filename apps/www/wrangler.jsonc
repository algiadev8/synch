{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "synch-www",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-04-17",
	"assets": {
		"binding": "ASSETS",
		"run_worker_first": true,
		"directory": "./dist",
		"html_handling": "force-trailing-slash",
		"not_found_handling": "none"
	}
}

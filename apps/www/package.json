{
  "name": "www",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test:billing": "node --test test/billing-settings.test.mjs test/billing-success.test.mjs test/pricing-checkout.test.mjs",
    "preview": "astro preview",
    "preview:cloudflare": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:built": "wrangler deploy",
    "astro": "astro",
    "storybook": "storybook dev -p 6007 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "typecheck:storybook": "tsgo --noEmit -p .storybook/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.1",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@storybook-astro/framework": "1.12.0",
    "@storybook/builder-vite": "10.6.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^2.0.7",
    "storybook": "10.6.0",
    "wrangler": "^4.114.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
